<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scouty.Frontend.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Label
                Text="Connexion"
                HorizontalOptions="Center"
                FontSize="28"
                FontFamily="bold"
            />

            <Border
                Stroke="Black"
                StrokeThickness="1"
                HorizontalOptions="Fill"
                HeightRequest="1"
            />


            <Label
                Text="Bienvenue! Connectez-vous pour accéder à votre espace."
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Adresse e-mail"
            />

            <Entry
                Placeholder="Entrez-votre e-mail"
            />
            
            
            <Label
                Text="Mot de passe"
            />

            <Entry
                Placeholder="Entrez votre mot de passe"
             />

            <Label
                Text="Mot de passe oublié ?"
                TextColor="#04BBFF"
            />


            <Button
                Text="Se connecter"   
                TextColor="White"
                BackgroundColor="#04BBFF"
                
            />

            <Label
                Text="S'inscrire"
                TextColor="#04BBFF"
                
            />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
