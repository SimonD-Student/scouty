<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Scouty.Frontend.MainPage"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto, Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="50, *" Padding="10,15">
            <Label Text="&#xE72B;" 
                   FontFamily="Segoe MDL2 Assets" 
                   FontSize="20"
                   HorizontalOptions="Center" 
                   VerticalOptions="Center"/>

            <Label Grid.Column="0" Grid.ColumnSpan="2"
                   Text="Connexion"
                   TextColor="#1a1a1a"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   FontSize="20"
                   FontAttributes="Bold"/>
        </Grid>

        <BoxView Grid.Row="1" 
                 HeightRequest="1" 
                 Color="#E5E5E5" 
                 VerticalOptions="End"/>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="30,20" Spacing="20">

                <Label Text="Bienvenue ! Connectez-vous pour accéder à votre espace."
                       TextColor="#2F4F4F"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       FontSize="15"
                       FontAttributes="Bold"
                       Margin="0,0,0,10"/>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Adresse e-mail" 
                           TextColor="Black" 
                           FontAttributes="Bold" 
                           FontSize="14"/>

                    <Border Stroke="#E5E5E5" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 8"
                            HeightRequest="50"
                            Padding="15,0">
                        <Grid ColumnDefinitions="30, *">
                            <Path Data="M20,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,8l-8,5L4,8V6l8,5l8-5V8z"
                                  Fill="#04BBFF"
                                  Aspect="Uniform"
                                  HeightRequest="20"
                                  HorizontalOptions="Start"
                                  VerticalOptions="Center"/>

                            <Entry Grid.Column="1"
                                   Placeholder="entrez votre e-mail"
                                   TextColor="Black"
                                   PlaceholderColor="#A0A0A0"
                                   VerticalOptions="Center"
                                   Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Mot de passe" 
                           TextColor="Black" 
                           FontAttributes="Bold" 
                           FontSize="14"/>

                    <Border Stroke="#E5E5E5" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 8"
                            HeightRequest="50"
                            Padding="15,0">
                        <Grid ColumnDefinitions="30, *">
                            <Path Data="M18,8h-1V6c0-2.76-2.24-5-5-5S7,3.24,7,6v2H6c-1.1,0-2,0.9-2,2v10c0,1.1,0.9,2,2,2h12c1.1,0,2-0.9,2-2V10 C20,8.9,19.1,8,18,8z M12,17c-1.1,0-2-0.9-2-2c0-1.1,0.9-2,2-2s2,0.9,2,2C14,16.1,13.1,17,12,17z M9,8V6c0-1.66,1.34-3,3-3s3,1.34,3,3v2H9z"
                                  Fill="#04BBFF"
                                  Aspect="Uniform"
                                  HeightRequest="20"
                                  HorizontalOptions="Start"
                                  VerticalOptions="Center"/>

                            <Entry Grid.Column="1"
                                   IsPassword="True"
                                   Placeholder="entrez votre mot de passe"
                                   TextColor="Black"
                                   PlaceholderColor="#A0A0A0"
                                   VerticalOptions="Center"
                                   Margin="5,0,0,0"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <Label Text="Mot de passe oublié ?"
                       TextColor="#04BBFF"
                       FontSize="13"
                       FontAttributes="Bold"
                       HorizontalOptions="End"/>

                <Button Text="Se connecter"
                        TextColor="White"
                        BackgroundColor="#04BBFF"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="50"
                        Margin="0,10,0,0"/>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,10,0,0">
                    <Label Text="Pas encore de compte ?" 
                           TextColor="#1a1a1a"
                           FontSize="14"/>
                    <Label Text="S'inscrire" 
                           TextColor="#04BBFF" 
                           FontAttributes="Bold"
                           FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>