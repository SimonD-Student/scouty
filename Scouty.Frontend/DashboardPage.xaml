<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Scouty.Frontend.ViewModels"
             x:DataType="viewmodels:DashboardViewModel"
             x:Class="Scouty.Frontend.DashboardPage"
             Title="Tableau de bord"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="{Binding WelcomeMessage}" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#1F2937"/>

            <Border StrokeShape="RoundRectangle 15"
                    BackgroundColor="#003E5C"
                    Padding="20"
                    StrokeThickness="0">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToBudgetDetailsCommand}" />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">

                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Solde Actuel" TextColor="#A0C4D6" FontSize="14"/>

                        <Label Text="{Binding Summary.CurrentBalance, StringFormat='{0:C} €'}" 
                               TextColor="White" 
                               FontSize="32" 
                               FontAttributes="Bold"
                               Margin="0,5,0,0"/>
                    </VerticalStackLayout>

                    <Label Grid.Column="1" Text=">" TextColor="White" VerticalOptions="Center" FontSize="24"/>
                </Grid>
            </Border>

            <Border StrokeShape="RoundRectangle 15"
        BackgroundColor="#007198"
        Padding="20"
        StrokeThickness="0"
        Margin="0,10,0,0">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToEquipmentCommand}" />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Inventaire Matériel" TextColor="#A0C4D6" FontSize="14"/>
                        <Label Text="Gérer le stock" 
                   TextColor="White" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text=">" TextColor="White" VerticalOptions="Center" FontSize="24"/>
                </Grid>
            </Border>

            
            <Border StrokeShape="RoundRectangle 15" BackgroundColor="#0594D0" Padding="20" StrokeThickness="0" Margin="0,10,0,0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToCalendarCommand}" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                    <VerticalStackLayout>
                        <Label Text="Calendrier" TextColor="#CDEEFF" FontSize="14"/>
                        <Label Text="Prochains événements" TextColor="White" FontSize="24" FontAttributes="Bold" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text=">" TextColor="White" VerticalOptions="Center" FontSize="24"/>
                </Grid>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsLoading}" 
                               Color="#04BBFF"
                               HorizontalOptions="Center"/>

            <Button Text="Se déconnecter" 
                    Command="{Binding LogoutCommand}" 
                    BackgroundColor="#EF4444"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>