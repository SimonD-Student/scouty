<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Scouty.Frontend.ViewModels"
             x:DataType="viewmodels:AddTransactionViewModel"
             x:Class="Scouty.Frontend.AddTransactionPage"
             Title="Nouvelle Transaction"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">

                <Border StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        Padding="15">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTypeToExpenseCommand}"/>
                    </Border.GestureRecognizers>

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BackgroundColor" Value="#E5E7EB"/>
                            <Style.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsIncome}" Value="False">
                                    <Setter Property="BackgroundColor" Value="#EF4444"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Label Text="DÉPENSE (-)" 
                           HorizontalOptions="Center" FontAttributes="Bold">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Setter Property="TextColor" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="False">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                </Border>

                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        Padding="15">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SetTypeToIncomeCommand}"/>
                    </Border.GestureRecognizers>

                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BackgroundColor" Value="#E5E7EB"/>
                            <Style.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsIncome}" Value="True">
                                    <Setter Property="BackgroundColor" Value="#22C55E"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Label Text="RENTRÉE (+)" 
                           HorizontalOptions="Center" FontAttributes="Bold">
                        <Label.Style>
                            <Style TargetType="Label">
                                <Setter Property="TextColor" Value="Gray"/>
                                <Style.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsIncome}" Value="True">
                                        <Setter Property="TextColor" Value="White"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Label.Style>
                    </Label>
                </Border>
            </Grid>

            <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="5" StrokeThickness="0">
                <Entry Placeholder="Montant (€)"
                       Text="{Binding Amount}"
                       Keyboard="Numeric"
                       FontSize="18"
                       HorizontalTextAlignment="Center"/>
            </Border>

            <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="5" StrokeThickness="0">
                <Entry Placeholder="Description (ex: Courses, Cotisations...)"
                       Text="{Binding Description}"
                       FontSize="16"/>
            </Border>

            <Label Text="Catégorie" FontSize="14" TextColor="Gray" Margin="5,0,0,0"/>
            <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" Padding="0" StrokeThickness="0">
                <Picker Title="Choisir une catégorie"
                        ItemsSource="{Binding Categories}"
                        SelectedItem="{Binding SelectedCategory}"
                        FontSize="16"
                        TextColor="#1F2937"
                        TitleColor="Gray"/>
            </Border>

            <Button Text="Enregistrer"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#003E5C"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Margin="0,20,0,0"/>

            <Button Text="Annuler"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    HeightRequest="40"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>