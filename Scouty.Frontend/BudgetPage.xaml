<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:Scouty.Frontend.ViewModels"
             xmlns:dtos="clr-namespace:Scouty.Shared.DTOs;assembly=Scouty.Shared"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:DataType="viewmodels:BudgetViewModel"
             x:Class="Scouty.Frontend.BudgetPage"
             Title="Gestion du Budget"
             BackgroundColor="#F3F4F6">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Reset" Command="{Binding ResetHistoryCommand}" Order="Secondary"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto, Auto, *">

        <Border Grid.Row="0" BackgroundColor="#003E5C" StrokeThickness="0" Padding="20" Margin="0,0,0,10" StrokeShape="RoundRectangle 0,0,20,20">
            <VerticalStackLayout Spacing="5">
                <Label Text="Solde Actuel" TextColor="#A0C4D6" FontSize="14"/>
                <Label Text="{Binding CurrentBalance, StringFormat='{0:C}'}" TextColor="White" FontSize="36" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>

        <Border Grid.Row="1" StrokeShape="RoundRectangle 15" BackgroundColor="White" StrokeThickness="0" Padding="15" Margin="15,0,15,10">
            <VerticalStackLayout Spacing="15">

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                    <Button Text="Dépenses" 
                            Command="{Binding SetModeToExpensesCommand}"
                            HeightRequest="40" Padding="0" CornerRadius="8">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowExpenses}" Value="True">
                                <Setter Property="BackgroundColor" Value="#003E5C"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowExpenses}" Value="False">
                                <Setter Property="BackgroundColor" Value="#E5E7EB"/>
                                <Setter Property="TextColor" Value="Gray"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Grid.Column="1" Text="Revenus" 
                            Command="{Binding SetModeToIncomeCommand}"
                            HeightRequest="40" Padding="0" CornerRadius="8">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowExpenses}" Value="False">
                                <Setter Property="BackgroundColor" Value="#003E5C"/>
                                <Setter Property="TextColor" Value="White"/>
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding ShowExpenses}" Value="True">
                                <Setter Property="BackgroundColor" Value="#E5E7EB"/>
                                <Setter Property="TextColor" Value="Gray"/>
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>

                <Grid ColumnDefinitions="140, *" ColumnSpacing="10">

                    <micro:ChartView Chart="{Binding Chart}" HeightRequest="140" WidthRequest="140" Grid.Column="0"/>

                    <CollectionView Grid.Column="1" ItemsSource="{Binding LegendItems}" VerticalOptions="Center">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:LegendItem">
                                <Grid ColumnDefinitions="15, *, Auto" Margin="0,4">
                                    <BoxView Color="{Binding Color}" HeightRequest="10" WidthRequest="10" CornerRadius="5" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="12" TextColor="#374151" VerticalOptions="Center" Margin="5,0"/>
                                    <Label Grid.Column="2" Text="{Binding Amount, StringFormat='{0:0}€'}" FontSize="12" FontAttributes="Bold" TextColor="#1F2937" VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Transactions}" SelectionMode="None" Margin="15,0">
            <CollectionView.Header>
                <Label Text="Transactions Récentes" FontSize="18" FontAttributes="Bold" Margin="0,0,0,10" TextColor="#1F2937"/>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="Aucune transaction" TextColor="Gray" HorizontalOptions="Center" Margin="20"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:TransactionDto">
                    <Border StrokeShape="RoundRectangle 15" BackgroundColor="White" StrokeThickness="0" Padding="15" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="50, *, Auto">
                            <Border Grid.Column="0" HeightRequest="40" WidthRequest="40" StrokeShape="RoundRectangle 20" BackgroundColor="#04BBFF" HorizontalOptions="Start" StrokeThickness="0">
                                <Label Text="$" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White" FontAttributes="Bold"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                                <Label Text="{Binding Description}" FontAttributes="Bold" TextColor="#374151" LineBreakMode="TailTruncation"/>
                                <Label Text="{Binding Date, StringFormat='{0:dd MMM}'}" FontSize="12" TextColor="Gray"/>
                                <Label Text="{Binding CreatorName}" FontSize="10" TextColor="Gray" FontAttributes="Italic"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="{Binding Amount, StringFormat='{0:C}'}" TextColor="#1F2937" FontAttributes="Bold" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2" Text="+" Command="{Binding AddTransactionCommand}" BackgroundColor="#04BBFF" TextColor="White" FontSize="30" CornerRadius="30" HeightRequest="60" WidthRequest="60" HorizontalOptions="End" VerticalOptions="End" Margin="20" Shadow="{Shadow Brush=Black, Offset='2,2', Opacity=0.3}"/>

        <ActivityIndicator Grid.RowSpan="3" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#003E5C" VerticalOptions="Center" HorizontalOptions="Center"/>
    </Grid>
</ContentPage>